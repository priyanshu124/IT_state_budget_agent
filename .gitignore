# Environment
.env
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Data - don't commit raw data
data/raw/*
data/processed/*
data/output/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/output/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
# Include notebooks in repo, exclude only checkpoints
!*.ipynb

# Logs
logs/*.log

# OS
.DS_Store
Thumbs.db

# Large generated artifacts (exclude from git)
data/enriched/*
!data/enriched/.gitkeep
dbt-sql/*.duckdb
dbt-sql/logs/*
dbt-sql/target/*
mbtsa_work.duckdb
dashboard/.evidence/template/static/data/mbtsa/**/*.parquet
