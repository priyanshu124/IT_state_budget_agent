# Environment
.env
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Data - don't commit raw data
data/raw/*
data/processed/*
data/output/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/output/.gitkeep
#! Allow committing selected output artifacts (use Git LFS for large files)
!data/output/final_budget_enriched.csv
!data/output/final_budget_enriched.parquet
!data/output/tower_classifications.csv
!data/output/cost_pool_mappings.csv
!data/output/final_budget_enriched_final.csv

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
# Include notebooks in repo, exclude only checkpoints
!*.ipynb

# Logs
logs/*.log

# OS
.DS_Store
Thumbs.db

# Large binaries and generated artifacts
*.parquet
!data/output/*.parquet
data/enriched/*.csv
dashboard/build/_app/immutable/**/*.js
dashboard/build/_app/immutable/workers/*.js
dbt-sql/dbt_packages/**
