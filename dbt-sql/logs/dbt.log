      /*
    dim_program
    ===========
    Program/subprogram dimension with IT designation.
*/

with programs as (
    select distinct
        program_key,
        line_item_key,
        agency_code,
        agency_name,
        program_code,
        program_name,
        subprogram_code,
        subprogram_name,
        is_it,
        it_designation
    from "mbtsa"."main_staging"."stg_budget_line_items"
)

select * from programs
    );
  
  
[0m22:57:24.594299 [debug] [Thread-2 (]: Using duckdb connection "model.mbtsa.dim_agency"
[0m22:57:24.599296 [debug] [Thread-1 (]: On model.mbtsa.fct_it_spend: /* {"app": "dbt", "dbt_version": "1.8.9", "profile_name": "mbtsa", "target_name": "dev", "node_id": "model.mbtsa.fct_it_spend"} */

  
    
    

    create  table
      "mbtsa"."main_marts"."fct_it_spend__dbt_tmp"
  
    as (
      /*
    fct_it_spend
    =============
    Fact table for all IT-classified budget line items.
    This is the primary table for TBM analysis.
    
    Contains both IT and non-IT rows so stakeholders can compute
    IT-as-percentage-of-total. Use is_it = true to filter to IT only.
    
    Grain: same as staging — one row per budget line item.
*/

with budget as (
    select * from "mbtsa"."main_staging"."stg_budget_line_items"
),

final as (
    select
        -- === SURROGATE KEY ===
        md5(cast(coalesce(cast(fiscal_year as 
    string
), '') || '-' || coalesce(cast(line_item_key as 
    string
), '') || '-' || coalesce(cast(subobject_code as 
    string
), '') || '-' || coalesce(cast(fund_type as 
    string
), '') || '-' || coalesce(cast(budget_type as 
    string
), '') as 
    string
))                                       as spend_id,

        -- === TIME ===
        fiscal_year,
        
        -- === ORGANIZATIONAL DIMENSIONS ===
        agency_code,
        agency_name,
        unit_code,
        unit_name,
        program_code,
        program_name,
        subprogram_code,
        subprogram_name,
        line_item_key,
        program_key,

        -- === ACCOUNTING DIMENSIONS ===
        object_code,
        object_name,
        subobject_code,
        subobject_name,
        fund_type,
        budget_type,
        category_code,
        category_name,

        -- === TBM CLASSIFICATION ===
        is_it,
        it_designation,
        
        -- Tower (null for non-IT rows)
        it_tower,
        it_sub_tower,
        tower_confidence,
        
        -- Cost Pool (populated for ALL rows)
        cost_pool,
        cost_sub_pool,

        -- === MEASURE ===
        amount,
        
        -- === DERIVED MEASURES ===
        case when is_it then amount else 0 end      as it_amount,
        case when not is_it then amount else 0 end  as non_it_amount

    from budget
)

select * from final
    );
  
  
