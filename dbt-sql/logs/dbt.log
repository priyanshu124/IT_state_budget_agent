    create  table
      "mbtsa"."main_marts"."dim_agency__dbt_tmp"
  
    as (
      /*
    dim_agency
    ==========
    Agency dimension — one row per agency.
*/

with agencies as (
    select distinct
        agency_code,
        agency_name,
        category_code,
        category_name
    from "mbtsa"."main_staging"."stg_budget_line_items"
)

select
    agency_code,
    agency_name,
    category_code,
    category_name,
    case 
        when agency_code = 'F50' then true 
        else false 
    end as is_it_agency
from agencies
    );
  
  
