    create  table
      "mbtsa_work"."main"."custom_metrics_calendar__dbt_tmp"
  
    as (
      

with days as (
    select
        cast(d as date) as date_day
    from generate_series(
        date '1990-01-01',
        date '2030-01-01',
        interval 1 day
    ) as t(d)
),

final as (
    select
        date_day,
        cast(date_trunc('week', date_day) as date) as date_week,
        cast(date_trunc('month', date_day) as date) as date_month,
        cast(date_trunc('quarter', date_day) as date) as date_quarter,
        cast(date_trunc('year', date_day) as date) as date_year
    from days
)

select * from final
    );
  
  
[0m19:20:19.115919 [debug] [Thread-2 (]: Using duckdb connection "model.mbtsa.metricflow_time_spine"
[0m19:20:19.115919 [debug] [Thread-2 (]: On model.mbtsa.metricflow_time_spine: /* {"app": "dbt", "dbt_version": "1.8.9", "profile_name": "mbtsa", "target_name": "dev", "node_id": "model.mbtsa.metricflow_time_spine"} */

  
    
    

    create  table
      "mbtsa_work"."main"."metricflow_time_spine__dbt_tmp"
  
    as (
      /*
    metricflow_time_spine
    =====================
    Minimal time spine required by MetricFlow.
    One row per day across the fiscal year range.
    MetricFlow won't parse without this, even if
    no metrics use a time dimension.
*/



with days as (
    select
        unnest(
            generate_series(
                date '2017-01-01',
                date '2028-12-31',
                interval '1 day'
            )
        ) as date_day
)

select
    date_day::date as date_day
