[0m00:17:51.691065 [debug] [Thread-3 (]: On model.mbtsa.stg_budget_line_items: /* {"app": "dbt", "dbt_version": "1.8.9", "profile_name": "mbtsa", "target_name": "dev", "node_id": "model.mbtsa.stg_budget_line_items"} */

  
  create view "mbtsa_work"."main_staging"."stg_budget_line_items__dbt_tmp" as (
    /*
    stg_budget_line_items
    =====================
    Clean, typed, and renamed columns from raw budget data.
    This is the single entry point for all budget data in the project.
    
    Grain: one row per fiscal_year × organization_sub_code × comptroller_subobject_code × fund_type × budget_type
*/

with source as (
    select * from "mbtsa_work"."main"."budget_line_items"
),

staged as (
    select
        -- === KEYS ===
        organization_sub_code                       as line_item_key,
        fiscal_year::int                            as fiscal_year,

        -- === ORGANIZATIONAL HIERARCHY ===
        agency_code,
        agency_name,
        unit_code,
        unit_name,
        program_code,
        program_name,
        subprogram_code,
        subprogram_name,
        organization_code                           as program_key,

        -- === ACCOUNTING CODES ===
        object_code::varchar                        as object_code,
        object_name,
        comptroller_subobject_code::varchar         as subobject_code,
        comptroller_subobject_name                  as subobject_name,
        agency_subobject_code::varchar              as agency_subobject_code,
        agency_subobject_name,

        -- === BUDGET AMOUNTS ===
        budget::bigint                              as amount,
        type                                        as budget_type,
        fund_type_name                              as fund_type,

        -- === BUDGET CATEGORY ===
        category::varchar                           as category_code,
        category_title                              as category_name,

        -- === IT CLASSIFICATION (from pipeline) ===
        case 
            when is_IT = 'True' or is_IT = true then true
            else false
        end                                         as is_it,
        IT_designination                            as it_designation,

        -- === TOWER CLASSIFICATION (from Agent 3) ===
        tower                                       as it_tower,
        sub_tower                                   as it_sub_tower,
        confidence::float                           as tower_confidence,

        -- === COST POOL CLASSIFICATION (from Agent 2) ===
        cost_pool,
        cost_sub_pool

    from source
)

select * from staged
  );

[0m00:17:51.691065 [debug] [Thread-2 (]: Using duckdb connection "model.mbtsa.metricflow_time_spine"
[0m00:17:51.691065 [debug] [Thread-1 (]: On model.mbtsa.custom_metrics_calendar: /* {"app": "dbt", "dbt_version": "1.8.9", "profile_name": "mbtsa", "target_name": "dev", "node_id": "model.mbtsa.custom_metrics_calendar"} */

  
    
    

    create  table
      "mbtsa_work"."main"."custom_metrics_calendar__dbt_tmp"
  
    as (
      

with days as (
    select
        cast(d as date) as date_day
    from generate_series(
        date '1990-01-01',
        date '2030-01-01',
        interval 1 day
    ) as t(d)
),

final as (
    select
        date_day,
        cast(date_trunc('week', date_day) as date) as date_week,
        cast(date_trunc('month', date_day) as date) as date_month,
        cast(date_trunc('quarter', date_day) as date) as date_quarter,
        cast(date_trunc('year', date_day) as date) as date_year
    from days
)

select * from final
    );
  
  
[0m00:17:51.691065 [debug] [Thread-2 (]: On model.mbtsa.metricflow_time_spine: /* {"app": "dbt", "dbt_version": "1.8.9", "profile_name": "mbtsa", "target_name": "dev", "node_id": "model.mbtsa.metricflow_time_spine"} */

  
    
    

    create  table
      "mbtsa_work"."main"."metricflow_time_spine__dbt_tmp"
  
    as (
      /*
    metricflow_time_spine
    =====================
    Minimal time spine required by MetricFlow.
    One row per day across the fiscal year range.
    MetricFlow won't parse without this, even if
    no metrics use a time dimension.
*/



with days as (
    select
        unnest(
            generate_series(
                date '2017-01-01',
                date '2028-12-31',
                interval '1 day'
            )
        ) as date_day
)

select
    date_day::date as date_day
from days
    );
  
  
